<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:tag="window_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

<ScrollView
    android:id="@+id/main_scroll"
    android:tag="window_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/main_pad_h"
        android:paddingTop="16dp"
        android:paddingBottom="48dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_main_title"
            android:tag="title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LG TV Remote"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- App shortcuts (populated dynamically from settings) -->
        <LinearLayout
            android:id="@+id/shortcuts_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Power + Keyboard -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_power"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_red"
                    android:src="@drawable/ic_power"
                    android:scaleType="center"
                    android:contentDescription="Power" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Power"
                    android:textColor="#888888" android:tag="btn_label"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <Space android:layout_width="28dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_touchpad"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn" />

                    <ImageView
                        android:id="@+id/iv_touchpad_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_touchpad"
                        android:scaleType="center"
                        android:contentDescription="Touchpad" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Touchpad"
                    android:textColor="#888888" android:tag="btn_label"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <Space android:layout_width="28dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_keyboard"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                    android:src="@drawable/ic_keyboard"
                    android:scaleType="center"
                    android:contentDescription="Keyboard" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keyboard"
                    android:textColor="#888888" android:tag="btn_label"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- D-pad + pills + Back/Menu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Home + Input — above the d-pad circle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="-8dp">

                <!-- Offset to align with left edge of d-pad: vol pill (54) + space (10) -->
                <View android:layout_width="@dimen/pill_mirror" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <ImageButton
                        android:id="@+id/btn_home"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_home"
                        android:scaleType="center"
                        android:contentDescription="Home" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Two equal gaps: (dpad_size - 3×52) / 2 -->
                <View android:layout_width="@dimen/dpad_top_gap" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <ImageButton
                        android:id="@+id/btn_mute"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_mute"
                        android:scaleType="center"
                        android:contentDescription="Mute" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mute"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View android:layout_width="@dimen/dpad_top_gap" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <ImageButton
                        android:id="@+id/btn_input"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_input"
                        android:scaleType="center"
                        android:contentDescription="Input Source" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Input"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Mirror the left offset: pill_gap + pill_width = pill_mirror -->
                <View android:layout_width="@dimen/pill_mirror" android:layout_height="1dp" />

            </LinearLayout>

            <!-- Pills + D-pad row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Volume pill + label -->
                <LinearLayout
                    android:layout_width="@dimen/pill_width"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/volume_label"
                        android:tag="pill_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#CCFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <FrameLayout
                        android:id="@+id/volume_pill"
                        android:tag="pill"
                        android:layout_width="@dimen/pill_width"
                        android:layout_height="@dimen/dpad_size"
                        android:background="@drawable/bg_pill_dark"
                        android:clipToOutline="true"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/volume_bar"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_gravity="bottom"
                            android:background="#664FC3F7" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_volume_up"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_volume_up"
                                android:scaleType="fitCenter"
                                android:padding="14dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:contentDescription="Volume Up" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="1dp"
                                android:layout_gravity="center_horizontal"
                                android:background="#000000" android:tag="pill_divider" />

                            <ImageButton
                                android:id="@+id/btn_volume_down"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_volume_down"
                                android:scaleType="fitCenter"
                                android:padding="14dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:contentDescription="Volume Down" />

                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

                <Space android:layout_width="@dimen/pill_gap" android:layout_height="1dp" />

                <FrameLayout
                    android:layout_width="@dimen/dpad_size"
                    android:layout_height="@dimen/dpad_size">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_circle_dark" android:tag="dpad_ring" />

                    <ImageButton
                        android:id="@+id/btn_up"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="4dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_arrow_up"
                        android:scaleType="centerInside"
                        android:contentDescription="Up" />

                    <ImageButton
                        android:id="@+id/btn_down"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="4dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_arrow_down"
                        android:scaleType="centerInside"
                        android:contentDescription="Down" />

                    <ImageButton
                        android:id="@+id/btn_left"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="4dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_arrow_left"
                        android:scaleType="centerInside"
                        android:contentDescription="Left" />

                    <ImageButton
                        android:id="@+id/btn_right"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="centerInside"
                        android:contentDescription="Right" />

                    <Button
                        android:id="@+id/btn_ok"
                        android:layout_width="@dimen/ok_size"
                        android:layout_height="@dimen/ok_size"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ok"
                        android:text="OK"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <Space android:layout_width="@dimen/pill_gap" android:layout_height="1dp" />

                <!-- Brightness pill + label -->
                <LinearLayout
                    android:layout_width="@dimen/pill_width"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/brightness_label"
                        android:tag="pill_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#CCFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <FrameLayout
                        android:id="@+id/brightness_pill"
                        android:tag="pill"
                        android:layout_width="@dimen/pill_width"
                        android:layout_height="@dimen/dpad_size"
                        android:background="@drawable/bg_pill_dark"
                        android:clipToOutline="true"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/brightness_bar"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_gravity="bottom"
                            android:background="#44FFB74D" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_brightness_up"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_brightness_up"
                                android:scaleType="fitCenter"
                                android:padding="14dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:contentDescription="Brightness Up" />

                            <View
                                android:layout_width="34dp"
                                android:layout_height="1dp"
                                android:layout_gravity="center_horizontal"
                                android:background="#000000" android:tag="pill_divider" />

                            <ImageButton
                                android:id="@+id/btn_brightness_down"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_brightness_down"
                                android:scaleType="fitCenter"
                                android:padding="14dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:contentDescription="Brightness Down" />

                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Back + Menu — tight below the d-pad circle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="-8dp">

                <!-- Offset to align with left edge of d-pad: vol pill (54) + space (10) -->
                <View android:layout_width="@dimen/pill_mirror" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <ImageButton
                        android:id="@+id/btn_back"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_back"
                        android:scaleType="center"
                        android:contentDescription="Back" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Center gap: dpad_size minus two buttons (52+52) -->
                <View android:layout_width="@dimen/dpad_bottom_gap" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <ImageButton
                        android:id="@+id/btn_settings"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_settings"
                        android:scaleType="center"
                        android:contentDescription="Settings" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menu"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Mirror the left offset: pill_gap + pill_width = pill_mirror -->
                <View android:layout_width="@dimen/pill_mirror" android:layout_height="1dp" />

            </LinearLayout>

        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Bottom area: normal row swaps in-place with color row on Colors tap -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Screen Off + Picture + Sound + Colors + Numpad -->
            <LinearLayout
                android:id="@+id/normal_bottom_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="5">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btn_screen_off"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_screen_off"
                        android:scaleType="center"
                        android:contentDescription="Screen Off" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screen Off"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btn_picture"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_picture"
                        android:scaleType="center"
                        android:contentDescription="Picture Mode" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Picture"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <Button
                        android:id="@+id/btn_numpad"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:text="123"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:padding="0dp"
                        android:contentDescription="Numpad" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Numpad"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btn_colors"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_colors"
                        android:scaleType="center"
                        android:contentDescription="Color Buttons" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colors"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btn_sound"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                        android:src="@drawable/ic_sound"
                        android:scaleType="center"
                        android:contentDescription="Sound Mode" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sound"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Color buttons — shown on Colors tap, any next tap restores normal row -->
            <LinearLayout
                android:id="@+id/color_buttons_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btn_color_red"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_red"
                        android:contentDescription="Red" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Red"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btn_color_green"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_green"
                        android:contentDescription="Green" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Green"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btn_color_yellow"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_yellow"
                        android:contentDescription="Yellow" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yellow"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/btn_color_blue"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_blue"
                        android:contentDescription="Blue" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blue"
                        android:textColor="#888888" android:tag="btn_label"
                        android:textSize="11sp"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</ScrollView>

<!-- Numpad mode — chrome-less dialer, swaps with the main remote via the 123 / Remote toggle -->
<ScrollView
    android:id="@+id/numpad_scroll"
    android:tag="window_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/main_pad_h"
        android:paddingTop="16dp"
        android:paddingBottom="48dp">

        <TextView
            android:tag="title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LG TV Remote"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Ghost readout — echoes typed digits, then fades (see echoReadout) -->
        <TextView
            android:id="@+id/tv_np_readout"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:gravity="center"
            android:text=""
            android:textColor="#3D3D3F"
            android:textSize="52sp"
            android:fontFamily="sans-serif-thin"
            android:letterSpacing="0.06" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Dialer keys -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_num_1"
                style="@style/GhostKey"
                android:text="1" />
            <Button
                android:id="@+id/btn_num_2"
                style="@style/GhostKey"
                android:layout_marginStart="8dp"
                android:text="2" />
            <Button
                android:id="@+id/btn_num_3"
                style="@style/GhostKey"
                android:layout_marginStart="8dp"
                android:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_num_4"
                style="@style/GhostKey"
                android:text="4" />
            <Button
                android:id="@+id/btn_num_5"
                style="@style/GhostKey"
                android:layout_marginStart="8dp"
                android:text="5" />
            <Button
                android:id="@+id/btn_num_6"
                style="@style/GhostKey"
                android:layout_marginStart="8dp"
                android:text="6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_num_7"
                style="@style/GhostKey"
                android:text="7" />
            <Button
                android:id="@+id/btn_num_8"
                style="@style/GhostKey"
                android:layout_marginStart="8dp"
                android:text="8" />
            <Button
                android:id="@+id/btn_num_9"
                style="@style/GhostKey"
                android:layout_marginStart="8dp"
                android:text="9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_num_list"
                style="@style/GhostKeyWord"
                android:text="LIST"
                android:contentDescription="Channel List" />
            <Button
                android:id="@+id/btn_num_0"
                style="@style/GhostKey"
                android:layout_marginStart="8dp"
                android:text="0" />
            <Button
                android:id="@+id/btn_num_dash"
                style="@style/GhostKey"
                android:layout_marginStart="8dp"
                android:text="–"
                android:contentDescription="Dash" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Channel rocker -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btn_np_ch_down"
                style="@style/GhostKey"
                android:layout_height="48dp"
                android:textSize="26sp"
                android:text="−"
                android:contentDescription="Channel Down" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="CH"
                android:textColor="#5A5A5E" android:tag="btn_label"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.3" />
            <Button
                android:id="@+id/btn_np_ch_up"
                style="@style/GhostKey"
                android:layout_height="48dp"
                android:textSize="26sp"
                android:text="+"
                android:contentDescription="Channel Up" />
        </LinearLayout>

        <!-- Small keys -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">
            <Button
                android:id="@+id/btn_np_guide"
                style="@style/GhostText"
                android:text="GUIDE" />
            <Button
                android:id="@+id/btn_np_info"
                style="@style/GhostText"
                android:layout_marginStart="14dp"
                android:text="INFO" />
            <Button
                android:id="@+id/btn_np_cc"
                style="@style/GhostText"
                android:layout_marginStart="14dp"
                android:text="CC"
                android:contentDescription="Subtitles" />
            <Button
                android:id="@+id/btn_np_exit"
                style="@style/GhostText"
                android:layout_marginStart="14dp"
                android:text="EXIT" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Toggle back — same slot as the 123 button on the main remote -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5">

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_numpad_close"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
                    android:src="@drawable/ic_remote"
                    android:scaleType="center"
                    android:contentDescription="Back to Remote" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remote"
                    android:textColor="#888888" android:tag="btn_label"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

<!-- Status dot + settings button — top-right corner -->
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_margin="8dp">

    <View
        android:id="@+id/status_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btn_app_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_settings"
        android:scaleType="center"
        android:alpha="0.35"
        android:contentDescription="App Settings" />

</LinearLayout>

<!-- Touchpad overlay — sits on top of everything, shown only during touchpad mode -->
<FrameLayout
    android:id="@+id/touchpad_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EE000000"
    android:visibility="gone">

    <!-- Growing border around the screen edge -->
    <com.nic.lgpower.LockBorderView
        android:id="@+id/lock_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/touchpad_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:text="Drag to move cursor"
        android:textColor="#66FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_touchpad_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_exit_button"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="Exit"
        android:textColor="#E53935"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="72dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_touchpad_back"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circle_dark" android:tag="circle_btn"
            android:src="@drawable/ic_back"
            android:scaleType="center"
            android:contentDescription="Back" />

        <Button
            android:id="@+id/btn_touchpad_click"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_squircle_dark"
            android:text="Click"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>

</FrameLayout>
