    <dimen name="pill_width">48dp</dimen>
    <dimen name="dpad_size">200dp</dimen>
    <dimen name="ok_size">84dp</dimen>
    <dimen name="pill_gap">8dp</dimen>
    <!-- pill_gap + pill_width -->
    <dimen name="pill_mirror">56dp</dimen>
</resources>
