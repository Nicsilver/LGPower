<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LGRemote" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- Numpad dialer keys — colors here are dark-theme defaults, applyTheme re-derives them -->
    <style name="GhostKey">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_ghost_key</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GhostKeyWord" parent="GhostKey">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#B5B5B8</item>
        <item name="android:letterSpacing">0.2</item>
    </style>

    <style name="GhostText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">#9A9A9E</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
